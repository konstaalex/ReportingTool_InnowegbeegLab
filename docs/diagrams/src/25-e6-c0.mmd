    IMP["import step (to build): text per chapter → a scorable run"]
    R --> IN --> PR --> CH --> IMP
  end
  SC["<b>Scoring</b><br/>E6: same as every condition<br/>C0: evaluation against the original + manual source<br/>check on 30 statements (no evidence ids) → H9"]
