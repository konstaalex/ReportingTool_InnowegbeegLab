  classDef comp fill:#85bbf0,stroke:#5d8ab5,color:#0b2340
  classDef legacy fill:#d6e6f7,stroke:#5d8ab5,color:#0b2340,stroke-dasharray: 5 3
  classDef ext fill:#8c8c8c,stroke:#6b6b6b,color:#ffffff
  class UI cont
  class WSF,ING,IMG,EVB,DRF,LLM,VER,REV,EXP,REP,XP comp
  class EVL legacy
  class WSD,OLL,ORIG ext
