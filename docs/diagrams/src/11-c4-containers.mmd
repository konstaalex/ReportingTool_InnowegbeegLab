  HOST["<b>Hosted API</b><br/>[External: HTTPS, OpenAI-compatible]<br/>optional, E6"]
  LO["<b>LibreOffice</b><br/>[External: optional]<br/>Word → PDF"]
  ORIG[("<b>Original report PDF</b><br/>[External: confidential]")]

  RES -- "uses (browser)" --> UI
  TL -- "uses (terminal)" --> CLI
