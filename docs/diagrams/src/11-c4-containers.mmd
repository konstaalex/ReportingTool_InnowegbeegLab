flowchart TB
  RES["<b>Researchers</b><br/>[Person]"]
  TL["<b>Lab tech lead</b><br/>[Person]"]

  subgraph SYS["InnoBeweegLab reporting tool  [Software system]"]
    UI["<b>Review interface</b><br/>[Container: Python, Streamlit]<br/>7 tabs: data · images · draft · review ·<br/>export · report per model · experiments"]
    CLI["<b>Command-line tools</b><br/>[Container: Python]<br/>ingestion.cli · imaging.cli · experiments.cli<br/>reports.cli · llm.cli · evaluation.cli"]
    CORE["<b>Core library</b><br/>[Container: Python 3.11 packages]<br/>ingestion · imaging · evidence · drafting · llm<br/>verification · review · export · reports · experiments<br/>facade: app.services.Workspace"]
    WS[("<b>Workspace</b><br/>[Container: JSON files on disk, git-ignored]<br/>ingest/ · evidence/ · drafts/ · reviews/ (hash-chained)<br/>images/ · runs/ · reports/ · exports/")]
    CFG[("<b>Configuration and prompts</b><br/>[Container: TOML + text files in git]<br/>models · experiments · report structure ·<br/>survey mapping · images · writing and RIVM rules ·<br/>prompts v1, v2")]
  end

  DATA[("<b>Research data folder</b><br/>[External: files]")]
